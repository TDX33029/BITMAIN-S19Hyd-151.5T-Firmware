--cpu Cortex-M3
".\startup_stm32f103xb.o"
".\main.o"
".\icsp.o"
".\uart.o"
".\protocol.o"
".\uprintf.o"
".\default_firmware.o"
".\stm32f1xx_it.o"
".\stm32f1xx_hal_msp.o"
".\system_stm32f1xx.o"
".\stm32f1xx_hal.o"
".\stm32f1xx_hal_rcc.o"
".\stm32f1xx_hal_rcc_ex.o"
".\stm32f1xx_hal_gpio.o"
".\stm32f1xx_hal_gpio_ex.o"
".\stm32f1xx_hal_cortex.o"
".\stm32f1xx_hal_dma.o"
".\stm32f1xx_hal_exti.o"
".\stm32f1xx_hal_flash.o"
".\stm32f1xx_hal_flash_ex.o"
".\stm32f1xx_hal_pwr.o"
--library_type=microlib --strict --scatter ".\Flasher.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list ".\Listings\Flasher.map" -o .\Flasher.axf