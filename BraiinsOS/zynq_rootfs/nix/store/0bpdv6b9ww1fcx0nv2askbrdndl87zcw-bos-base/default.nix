# BOS Base Module
# Defines core BOS identity options, system config files (/etc/*),
# and essential directory structure (FHS skeleton)
{ lib, pkgs, config, ... }:

let
  inherit (lib) mkOption types;
  inherit (lib.pseudofile) dir symlink fileWithMode;
in
{
  options = {
    bosPlatform = mkOption {
      description = "Platform identifier (e.g., am3-aml, am3-bbb)";
      type = types.nonEmptyStr;
    };

    bosVersion = mkOption {
      description = "BOS firmware version string";
      type = types.nonEmptyStr;
    };

    bosMajor = mkOption {
      description = "Minimum BOS version for downgrade compatibility";
      type = types.nonEmptyStr;
    };

    bosRequire = mkOption {
      description = "Required BOS version for upgrade";
      type = types.nonEmptyStr;
    };

    bosBuild = mkOption {
      description = "BOS build identifier (usually same as bosPlatform)";
      type = types.nonEmptyStr;
      default = config.bosPlatform;
    };

    bosArch = mkOption {
      description = "Architecture string for firmware feeds (matches toolbox naming, e.g., aarch64_armv8-a, omap)";
      type = types.nonEmptyStr;
    };
  };

  config = {
    filesystem = dir {
      # Mount points (must exist before init mounts to them)
      proc = dir { };
      sys = dir { };
      tmp = dir { };
      mnt = dir { };
      media = dir { };
      opt = dir { };
      run = dir { };

      # User directories
      root = dir { };
      home = dir { };

      # Device subdirectories (for mount points)
      dev = dir {
        pts = dir { };
        shm = dir { };
        log = symlink "../tmp/log"; # syslog socket
      };

      # Var structure (needed by services)
      var = dir {
        lib = dir { };
        run = symlink "../run"; # -> /run (tmpfs, writable)
        log = symlink "../etc/log"; # persistent logs
        # /var/lock must be writable: bosminer creates /var/lock/bosminer.lock
        # at startup. On a read-only squashfs rootfs (cvitek) a plain dir is
        # read-only, so point it at the tmpfs /run like /var/run.
        lock = symlink "../run"; # -> /run (tmpfs, writable)
        cache = dir { };
        spool = dir {
          tmp = dir { };
        };
      };

      # Usr additions (beyond what's created by file installations)
      usr = dir {
        lib = dir { };
        libexec = dir { };
        share = dir {
          terminfo = dir {
            x = dir { };
          };
        };
      };

      etc = dir {
        # BOS version/platform files
        bos_platform = fileWithMode "0644" (pkgs.writeText "bos_platform" "${config.bosPlatform}\n");
        bos_version = fileWithMode "0644" (pkgs.writeText "bos_version" "${config.bosVersion}\n");
        # bos_mode is written by the rootfs builder (pkgs/rootfs-image.nix),
        # parametrized per image (nand/sd)
        bos_major = fileWithMode "0644" (pkgs.writeText "bos_major" "${config.bosMajor}\n");
        bos_build = fileWithMode "0644" (pkgs.writeText "bos_build" "${config.bosBuild}\n");

        # System config files
        # shadow is generated by users.nix
        hosts = fileWithMode "0644" ./hosts;
        protocols = fileWithMode "0644" ./protocols;
        services = fileWithMode "0644" ./services;
        fstab = fileWithMode "0644" ./fstab;
        profile = fileWithMode "0644" ./profile;
        shells = fileWithMode "0644" ./shells;
        hostname = fileWithMode "0644" ./hostname;

        # Persistent log directory
        log = dir { };

        # Symlinks
        # /etc/localtime and /etc/timezone live in the tzdata module
        "resolv.conf" = symlink "../tmp/resolv.conf";
        mtab = symlink "../proc/self/mounts";

        "profile.d" = dir {
          "umask.sh" = fileWithMode "0644" ./umask.sh;
        };
      };
    };
  };
}
