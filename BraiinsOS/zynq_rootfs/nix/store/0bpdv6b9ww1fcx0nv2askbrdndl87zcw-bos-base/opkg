usage() {
    echo "usage: opkg [options...] sub-command [arguments...]"
    echo "where sub-command is one of:"
    echo
    echo "Package Manipulation:"
    echo "        install <pkgs>          Install package(s)"
    echo
}

install_package() {
    local package_file=$1
    local tmp_dir="/tmp/opkg_install"
    mkdir -p "$tmp_dir"

    # Extract `.ipk` file to temp directory
    tar -zxf "$package_file" -C "$tmp_dir"
    # File `debian-binary` always have to have 2.0 content
    if [ "$(cat $tmp_dir/debian-binary 2> /dev/null)" = "2.0" ]; then
        # Extract only etc sub dir, other files is
        # not persistent on non OpenWrt system
        tar -zxf "$tmp_dir/data.tar.gz" -C "/" etc
        # Unpack control.tar.gz and execute `postinst-pkg` script if exists
        tar -zxf "$tmp_dir/control.tar.gz" -C "$tmp_dir"
        postinst_script="$tmp_dir/postinst-pkg"
        [ -f "$postinst_script" ] && "$postinst_script"
    else
        echo "package '$package_file' not supported" >&2
        usage
        exit 1
    fi
    # Clean up the temporary files
    rm -rf "$tmp_dir"
    echo "Package '$package_file' installed successfully"
}

install() {
    # Check number of arguments
    if [ $# -lt 1 ]; then
        echo "missing package file to install" >&2
        usage
        exit 1
    fi
    for package in "$@"; do
        install_package "$package"
    done
}

# Check number of arguments
if [ $# -lt 1 ]; then
    echo "missing command argument" >&2
    usage
    exit 1
fi

# Try to find command
command="$1"

case $command in
    install)
        shift
        $command "$@"
    ;;
    -h|--help)
        usage
    ;;
    *)  # Unknown command
        echo "unknown command '$command'" >&2
        usage
        exit 1
    ;;
esac
