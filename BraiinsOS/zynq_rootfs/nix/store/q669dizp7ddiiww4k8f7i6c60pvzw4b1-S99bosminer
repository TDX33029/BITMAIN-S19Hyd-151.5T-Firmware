#!/bin/sh
#
# Starts bosminer
#

SERVICE_NAME="bosminer"
SERVICE_COMMAND="/usr/bin/$SERVICE_NAME"
SERVICE_ARG1="--log-to-file"
SERVICE_PIDFILE="/var/run/$SERVICE_NAME.pid"
STOP_TIMEOUT=60

. /lib/functions/bos-defaults.sh

start() {
	printf "Starting $SERVICE_NAME: "

	start-stop-daemon -S -q -m -b -p "$SERVICE_PIDFILE" \
		-x "/usr/bin/bos-tools" -- "run-and-watch" -- "$SERVICE_COMMAND" "$SERVICE_ARG1"
	[ $? = 0 ] && echo "OK" || echo "FAIL"
}
stop() {                                                                        
	printf "Stopping $SERVICE_NAME: "                                       
	BOSMINER_PID=$(cat $SERVICE_PIDFILE)
	start-stop-daemon -K -q -o -R TERM/forever -p "$SERVICE_PIDFILE"
	if [ $? = 0 ]; then
		# BusyBox start-stop-daemon ignores -R, wait for the exit here.
		# The wait is bounded to avoid hanging shutdown forever (BOS-4005).
		if [ "${BOSMINER_PID}" != "" ]; then
			waited=0
			while [ -e /proc/${BOSMINER_PID} ] && [ $waited -lt $STOP_TIMEOUT ]; do
				sleep 1
				waited=$((waited + 1))
			done
			if [ -e /proc/${BOSMINER_PID} ]; then
				echo "S99bosminer: $SERVICE_NAME did not stop in ${STOP_TIMEOUT}s, sending SIGKILL" > /dev/kmsg
				# SIGKILL is not forwarded by the bos-tools wrapper, kill both
				kill -9 "${BOSMINER_PID}" 2>/dev/null
				killall -9 "$SERVICE_NAME" 2>/dev/null
			fi
		fi
		echo "OK"
		return
	fi
	echo "FAIL"
}     
restart() {
	stop
	start
}

case "$1" in
	start)
		start
	;;
	stop)
		stop
	;;
	restart|reload)
		restart
	;;
	*)
	echo "Usage: $0 {start|stop|restart}"
	exit 1
esac

exit $?
