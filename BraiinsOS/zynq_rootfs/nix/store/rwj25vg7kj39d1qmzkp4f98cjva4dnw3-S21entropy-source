#!/bin/sh
#
# Seeds the kernel entropy pool from the Zynq XADC so getrandom() users
# (boser login, dropbear host keys) do not block for ~2 minutes after
# boot. Backgrounded: sampling takes a few seconds and nothing here
# needs to wait for it.

case "$1" in
    start | "")
        add-entropy >/dev/kmsg 2>&1 &
        ;;
    stop)
        ;;
    *)
        echo "Usage: $0 {start|stop}" >&2
        exit 1
        ;;
esac
