# Sysvinit boot/shutdown marker; S02 = after S01syslogd so logger reaches
# syslog. Shared by bm1 and the nix firmware; keep in sync with the procd
# bos-boot-log.init.

# Persistent across a power cut (in /etc, not tmpfs).
BOS_BOOT_LOCK="/etc/bos_boot.lock"

bos_log() {
    logger -t bos -p "$1" "$2"
}

# A lock left over from the previous boot means an ungraceful shutdown.
bos_marker_boot() {
    if [ -f "${BOS_BOOT_LOCK}" ]; then
        bos_log daemon.warning \
            "Ungraceful shutdown detected (${BOS_BOOT_LOCK} survived the previous boot)"
    fi
    if : >"${BOS_BOOT_LOCK}" 2>/dev/null; then
        sync
    else
        bos_log daemon.err \
            "Failed to arm ${BOS_BOOT_LOCK}; ungraceful-shutdown detection disabled"
    fi
}

bos_marker_shutdown() {
    rm -f "${BOS_BOOT_LOCK}"
    if [ -e "${BOS_BOOT_LOCK}" ]; then
        bos_log daemon.err \
            "Failed to clear ${BOS_BOOT_LOCK}; next boot may be misread as ungraceful"
    fi
    sync
}

case "$1" in
    start) bos_log daemon.info "Miner booting"; bos_marker_boot ;;
    stop) bos_log daemon.info "Miner is going to shutdown"; bos_marker_shutdown ;;
    *)
        echo "Usage: $0 {start|stop}"
        exit 1
        ;;
esac
